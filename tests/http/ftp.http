# FTP Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - FTP directory operations.
# - Upload and download operations.
# - Representative schema validation errors.
# - Controlled service errors.
#
# This file may also be used for general API testing.
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:60004
# - FTP server configured and accessible
#
# Notes
# -----
# - dir defaults to "." when it is not provided.
# - Resource entries must include name and type.
# - Allowed entry types are DIR and FILE.
# - FILE responses include hasThumbnail.

@baseUrl = http://localhost:60004/ftp
@token = PASTE_ACCESS_TOKEN
@folderName = Test Folder
@fileName = test.txt
@thumbnailName = photo.jpg

############################################################
# List directory
#
# Expected:
# Status: 200
#
# Headers:
# Data-Version: <SHA-256 directory hash>
#
# Response:
# [
#   {
#       "name": "Test Folder",
#       "type": "DIR"
#   },
#   {
#       "name": "test.txt",
#       "type": "FILE",
#       "hasThumbnail": false
#   }
# ]
############################################################

GET {{baseUrl}}
Authorization: Bearer {{token}}

###

############################################################
# Get thumbnail
#
# Prerequisite:
# - List the directory first.
# - Ensure photo.jpg exists and hasThumbnail is true.
#
# Expected:
# Status: 200
# Content-Type: image/jpeg
#
# Response:
# JPEG image
############################################################

GET {{baseUrl}}/thumbnail/{{thumbnailName}}?dir=.
Authorization: Bearer {{token}}

###

############################################################
# ApiError - Thumbnail not available
#
# Expected:
# Status: 404
#
# Response:
# {
#   "code": "FTP_THUMBNAIL_NOT_FOUND",
#   "message": "La miniatura no existe"
# }
############################################################

GET {{baseUrl}}/thumbnail/{{fileName}}?dir=.
Authorization: Bearer {{token}}

###

############################################################
# Create directory
#
# Expected:
# Status: 201
# Headers:
# Data-Version: <SHA-256 directory hash>
#
# Response:
# [
#   {
#       "name": "Test Folder",
#       "type": "DIR"
#   }
# ]
############################################################

POST {{baseUrl}}/mkdir
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "{{folderName}}"
}

###

############################################################
# Upload file
#
# Expected:
# Status: 201
# Headers:
# Data-Version: <SHA-256 directory hash>
#
# Response:
# [
#   {
#       "name": "test.txt",
#       "type": "FILE",
#       "hasThumbnail": false
#   }
# ]
############################################################

POST {{baseUrl}}/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=Boundary

Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

Hello FTP
--Boundary--

###

############################################################
# Download file
#
# Expected:
# Status: 200
#
# Response:
# File download
############################################################

POST {{baseUrl}}/download
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": [
        { "name": "{{fileName}}", "type": "FILE" }
    ]
}

###

############################################################
# Delete entries
#
# Expected:
# Status: 200
# Headers:
# Data-Version: <SHA-256 directory hash>
#
# Response:
# []
############################################################

DELETE {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": [
        { "name": "{{fileName}}", "type": "FILE" }
    ]
}

###

############################################################
# Validation Error - Invalid directory path format
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "dir",
#           "message": "Error de formato"
#       }
#   ]
# }
############################################################

GET {{baseUrl}}?dir=../secret
Authorization: Bearer {{token}}

###

############################################################
# Validation Error - Missing folder name
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/mkdir
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

############################################################
# Validation Error - Invalid folder name format
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Error de formato"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/mkdir
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "???"
}

###

############################################################
# Validation Error - Missing download entries
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "entries",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/download
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

############################################################
# Validation Error - Empty download entries
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "entries",
#           "message": "Debe contener al menos un elemento"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/download
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": []
}

###

############################################################
# Validation Error - Missing entry type
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "entries.0.type",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/download
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": [
        { "name": "{{fileName}}" }
    ]
}

###

############################################################
# Validation Error - Invalid entry type
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "entries.0.type",
#           "message": "Valores permitidos: DIR, FILE"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/download
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": [
        { "name": "{{fileName}}", "type": "INVALID" }
    ]
}

###

############################################################
# Validation Error - Entry path traversal
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Error de formato"
#       }
#   ]
# }
############################################################

DELETE {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "entries": [
        { "name": "../secret.txt", "type": "FILE" }
    ]
}

###

############################################################
# ApiError - Upload without file
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "FTP_FILE_REQUIRED",
#   "message": "Debe proporcionar un archivo"
# }
############################################################

POST {{baseUrl}}/upload
Authorization: Bearer {{token}}
Content-Type: application/json

{}

###

############################################################
# Controlled service error
#
# How to reproduce:
# - Stop FTP server.
# - Use invalid FTP credentials.
# - Use invalid FTP host.
#
# Expected:
# Status: 500
#
# Response:
# {
#   "code": "FTP_DIR_FAILED",
#   "message": "Error al listar la carpeta"
# }
############################################################

GET {{baseUrl}}
Authorization: Bearer {{token}}

###
