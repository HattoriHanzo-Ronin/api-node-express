# Socket sessions
#
# Execute auth.http first and replace the access token.

@baseUrl = http://localhost:60004/socket-sessions
@accessToken = PASTE_ACCESS_TOKEN
@socketSessionId = PASTE_SOCKET_SESSION_ID

### Create a socket session
POST {{baseUrl}}
Authorization: Bearer {{accessToken}}

### Refresh a socket session
POST {{baseUrl}}/{{socketSessionId}}/refresh
Authorization: Bearer {{accessToken}}

### Close a socket session before logging out this client
DELETE {{baseUrl}}/{{socketSessionId}}
Authorization: Bearer {{accessToken}}

### WebSocket protocol
#
# Connect to ws://localhost:60004/events/{{socketSessionId}}.
# Send this single subscription message immediately after connecting:
# { "accessToken": "{{accessToken}}", "entities": ["devices", "whitelist"] }
#
# The server then emits only changes for the authorized subscribed entities.
# FTP changes include the affected directory: { "entity": "ftp", "dir": "." }
