# Whitelist Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Whitelist operations.
# - Schema validation errors.
# - Business rules.
#
# This file may also be used for general API testing.
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:59998
#
# Notes
# -----
# - The router must exist.
# - The allowed device must exist.
# - The allowed device must not already be associated with the router.

@baseUrl = http://localhost:59998/whitelist
@token = PASTE_ACCESS_TOKEN

############################################################
# Create whitelist entry
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "..."
# }
############################################################

POST {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "ALLOWED_DEVICE_ID",
    "name": "Desktop",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Delete whitelist entry
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "..."
# }
############################################################

DELETE {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "ALLOWED_DEVICE_ID",
    "name": "Desktop",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Validation Error - Missing allowed device id
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "id",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Validation Error - Missing device name
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "ALLOWED_DEVICE_ID",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Validation Error - Missing MAC
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "mac",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "ALLOWED_DEVICE_ID",
    "name": "Desktop"
}

###

############################################################
# Validation Error - Invalid device id
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "id",
#           "message": "UUID no válido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/ROUTER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "INVALID",
    "name": "Desktop",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Validation Error - Invalid router id
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "id",
#           "message": "UUID no válido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/INVALID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "ALLOWED_DEVICE_ID",
    "name": "Desktop",
    "mac": "AA:BB:CC:DD:EE:10"
}

###

############################################################
# Validation Error - Invalid MAC
