# Whitelist Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Whitelist operations.
# - Representative schema validation errors.
# - Business rules.
#
# This file may also be used for general API testing.
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:59998
#
# Notes
# -----
# - The router must exist.
# - The allowed device must exist.
# - The allowed MAC must belong to the allowed device.
# - The allowed device must not already be associated with the router.

@baseUrl = http://localhost:59998/whitelist
@token = PASTE_ACCESS_TOKEN
@routerId = PASTE_ROUTER_ID
@allowedDeviceId = PASTE_ALLOWED_DEVICE_ID
@allowedMac = PASTE_MAC

############################################################
# Create whitelist entry
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "...",
#   "mac": "AA:BB:CC:DD:EE:10"
# }
############################################################

POST {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "{{allowedMac}}"
}

###

############################################################
# Delete whitelist entry
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "...",
#   "mac": "AA:BB:CC:DD:EE:10"
# }
############################################################

DELETE {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "{{allowedMac}}"
}

###

############################################################
# Validation Error - Invalid router id
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "id",
#           "message": "UUID no válido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/INVALID
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "{{allowedMac}}"
}

###

############################################################
# Business Error - Router not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El router no existe"
# }
############################################################

POST {{baseUrl}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "{{allowedMac}}"
}

###

############################################################
# Business Error - Device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

POST {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "00000000-0000-0000-0000-000000000000",
    "mac": "AA:BB:CC:DD:EE:99"
}

###

############################################################
# Business Error - MAC does not belong to device
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "La mac no pertenece al dispositivo especificado"
# }
############################################################

POST {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "AA:BB:CC:DD:EE:99"
}

###

############################################################
# Business Error - Device not allowed
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no se encuentra autorizado"
# }
############################################################

DELETE {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "AA:BB:CC:DD:EE:99"
}

###

############################################################
# Business Error - Duplicate whitelist entry
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "El dispositivo ya se encuentra autorizado"
# }
############################################################

POST {{baseUrl}}/{{routerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{allowedDeviceId}}",
    "mac": "{{allowedMac}}"
}
