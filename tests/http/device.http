############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Server Test",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "SERVER"
}

###

############################################################
# ApiError: Duplicate device
#
# How to reproduce:
#
# 1. Execute this request once.
#    Expected: 201 Created.
#
# Response:
# Returns the identifier of the newly created device.
#
# 2. Execute the same request again.
#    Expected: 400 Bad Request.
#
# Response:
# {
#   "message": "El dispositivo ya existe"
# }
############################################################

POST {{baseUrl}}/device
Content-Type: application/json

{
    "name": "Duplicated Device",
    "mac": "AA:BB:CC:DD:EE:01",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# ApiError: Device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

DELETE  {{baseUrl}}/d5959649-78ac-4fc3-8857-fc5abfa4b1a0

###

