#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "id",
#       "message": "UUID no válido"
#     }
#   ]
# }
############################################################

PUT {{baseUrl}}
Content-Type: application/json

{
    "id": "BAD_ID",
    "name": "New Name"
}

###

############################################################
# Validation: Name below minimum length
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "name",
#       "message": "Longitud mínima 4 caracteres"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "abc",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# Validation: Model exceeds maximum length
# Expected:
# Status: 400
#
# Response:
#{
#  "message": "Error al validar los datos",
#  "details": [
#    {
#      "field": "model",
#      "message": "Longitud máxima 60 caracteres"
#    }
#  ]
#}
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Router Test",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "ROUTER",
    "model": "TP-Link Archer AX53 Ultra Gigabit Extended Edition Pro 456789TL",
    "ip": "192.168.1.1",
    "admin_pass": "Admin123!",
    "mac_filter": true
}

###

############################################################
# Validation: Router requires MAC filter support
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "mac_filter",
#       "message": "Debe especificar si el router soporta filtrado MAC"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Router Test",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "ROUTER",
    "model": "TP-Link Archer AX53",
    "ip": "192.168.1.1",
    "admin_pass": "Admin123!"
}

###

############################################################
# Validation: Client cannot use MAC filtering
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "mac_filter",
#       "message": "Solo el router soporta filtrado MAC"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Client Test",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT",
    "mac_filter": true
}

###

############################################################
