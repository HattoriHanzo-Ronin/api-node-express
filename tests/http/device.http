#       "message": "Error de formato"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Client Test",
    "mac": "BAD_MAC",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

