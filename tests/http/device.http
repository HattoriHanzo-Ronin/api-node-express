# Device Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Schema validation errors.
# - ApiError responses.
# - Service layer errors.
# - Error handler responses.
#
# This file may also be used for general API testing by adding
# custom requests to verify normal device operations.
#
# Prerequisites
# -------------
# - API running on localhost:59998/device
# - Database configured

@baseUrl = http://localhost:59998/device

############################################################
# Validation: Missing required field
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "name",
#       "message": "Requerido"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# Validation: Invalid field type
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#     {
#       "field": "name",
#       "message": "Tipo no válido"
#     }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "name": 123,
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# Validation: Invalid MAC format
#
