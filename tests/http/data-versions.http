# Data Versions Tests
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:60004

@baseUrl = http://localhost:60004/data-versions
@token = PASTE_ACCESS_TOKEN
@resources = ftp,devices,whitelist,users

############################################################
# Get resource version
#
# Expected:
# Status: 200
# Response:
# {
#   "ftp": "1",
#   "devices": "1",
#   "whitelist": "1",
#   "users": "1"
# }
############################################################

GET {{baseUrl}}?id={{resources}}
Authorization: Bearer {{token}}
