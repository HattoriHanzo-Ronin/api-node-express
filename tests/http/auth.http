# Authentication Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Authentication requests.
# - Token refresh.
# - Logout.
#
# This file should be executed before testing
# protected endpoints.
#
# Prerequisites
# -------------
# - API running on localhost:60004
# - Existing user in database
#
# Notes
# -----
# - Login and refresh always return complete user information.

@baseUrl = http://localhost:60004/auth
@accessToken = PASTE_ACCESS_TOKEN
@refreshToken = PASTE_REFRESH_TOKEN

############################################################
# Login
#
# Expected:
# Status: 200
#
# Response:
# {
#   "user": {
#       "id": "...",
#       "username": "test_user",
#       "roles": ["ADMIN"],
#       "scope": ["ADMIN"]
#   },
#   "accessToken": "...",
#   "refreshToken": "..."
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "username": "test_user",
    "password": "Password123!"
}

###

############################################################
# Refresh token
#
# Expected:
# Status: 200
#
# Response:
# {
#   "user": {
#       "id": "...",
#       "username": "test_user",
#       "roles": ["ADMIN"],
#       "scope": ["ADMIN"]
#   },
#   "accessToken": "...",
#   "refreshToken": "..."
# }
############################################################

POST {{baseUrl}}/refresh
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

###

############################################################
# Logout
#
# Expected:
# Status: 204
#
# Response:
# Empty body
############################################################

POST {{baseUrl}}/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

###

############################################################
# Validation Error - Invalid username format
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "username",
#           "message": "Error de formato"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "username": "test user",
    "password": "Password123!"
}

###

############################################################
# Validation Error - Password below minimum length
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "password",
#           "message": "Longitud mínima 12 caracteres"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "username": "test_user",
    "password": "Short1!"
}

###

############################################################
# Validation Error - Missing refresh token
#
# Expected:
# Status: 400
#
# Response:
# {
#   "code": "VALIDATION_FAILED",
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "refreshToken",
#           "message": "Requerido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}/refresh
Content-Type: application/json

{}

###

############################################################
# Business Error - Invalid credentials
#
# Expected:
# Status: 401
#
# Response:
# {
#   "code": "USER_INVALID_CREDENTIALS",
#   "message": "Usuario o contraseña incorrectos"
# }
############################################################

POST {{baseUrl}}
Content-Type: application/json

{
    "username": "test_user",
    "password": "WrongPassword123!"
}

###

############################################################
# Business Error - Invalid refresh token
#
# Expected:
# Status: 401
#
# Response:
# {
#   "code": "INVALID_TOKEN",
#   "message": "Token no válido"
# }
############################################################

POST {{baseUrl}}/refresh
Content-Type: application/json

{
    "refreshToken": "invalid-token"
}
