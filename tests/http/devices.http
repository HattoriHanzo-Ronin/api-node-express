# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "message": "Debe enviar un objeto válido"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}

###

############################################################
# Validation Error - Invalid name format
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Error de formato"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop@Test",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:41", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}

###

############################################################
# Validation Error - Name below minimum length
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "name",
#           "message": "Longitud mínima 4 caracteres"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "abc",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:42", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}

###

