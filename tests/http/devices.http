############################################################
# SuperRefine - Duplicated connection ctype
#
# Expected:
# Status: 400
#
# Response:
# {
#   "message": "Error al validar los datos",
#   "details": [
#       {
#           "field": "connections.ctype",
#           "message": "El ctype LAN se encuentra duplicado"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop Test",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:53", "ctype": "LAN" },
        { "mac": "AA:BB:CC:DD:EE:54", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}
