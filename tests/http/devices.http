# Devices Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Device CRUD operations.
# - Schema validation errors.
# - Business rules.
# - Error handler responses.
#
# This file may also be used for general API testing.
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:59998
#
# Notes
# -----
# - CLIENT devices do not require an IP.
# - SERVER devices require a valid IP.
# - ROUTER devices require a valid IP, admin_pass and mac_filter.
# - ROUTER devices require model when mac_filter is true.
# - Only ROUTER devices can use admin_pass, wifi_pass and mac_filter.
# - MAC addresses must be unique.

@baseUrl = http://localhost:59998/devices
@token = PASTE_ACCESS_TOKEN

############################################################
# Get all devices
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Desktop Test",
#       "model": "Custom PC",
#       "mac": "AA:BB:CC:DD:EE:10",
#       "intrface": "LAN",
#       "type": "CLIENT"
#   },
#   {
#       "id": "...",
#       "name": "Router Test",
#       "model": "Mikrotik RB5009",
#       "mac": "AA:BB:CC:DD:EE:20",
#       "intrface": "LAN",
#       "type": "ROUTER",
#       "ip": "192.168.1.1",
#       "admin_pass": "Admin123!",
#       "wifi_pass": "WifiPass123!",
#       "mac_filter": true,
#       "capabilities": [...]
#   }
# ]
############################################################

GET {{baseUrl}}
Authorization: Bearer {{token}}

###

############################################################
# Get allowed devices
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Desktop Test",
#       "model": "Custom PC",
#       "mac": "AA:BB:CC:DD:EE:10",
#       "intrface": "LAN",
#       "type": "CLIENT"
#   }
# ]
############################################################

GET {{baseUrl}}/allowed/ROUTER_ID
Authorization: Bearer {{token}}

###

############################################################
# Get not allowed devices
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Server Test",
#       "model": "Proxmox VE",
#       "mac": "AA:BB:CC:DD:EE:30",
#       "intrface": "LAN",
#       "type": "SERVER"
#   }
# ]
############################################################

GET {{baseUrl}}/notallowed/ROUTER_ID
Authorization: Bearer {{token}}

###

############################################################
# Create client
#
# Expected:
# Status: 201
#
# Response:
# {
#   "id": "...",
#   "name": "Desktop Test",
#   "model": "Custom PC",
#   "mac": "AA:BB:CC:DD:EE:10",
#   "intrface": "LAN",
#   "type": "CLIENT"
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop Test",
    "model": "Custom PC",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# Create router
#
# Expected:
# Status: 201
#
# Response:
# {
#   "id": "...",
#   "name": "Router Test",
#   "model": "Mikrotik RB5009",
#   "mac": "AA:BB:CC:DD:EE:20",
#   "ip": "192.168.1.1",
#   "intrface": "LAN",
#   "type": "ROUTER",
#   "admin_pass": "Admin123!",
#   "wifi_pass": "WifiPass123!",
#   "mac_filter": true,
#   "capabilities": [...]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Router Test",
    "model": "Mikrotik RB5009",
    "mac": "AA:BB:CC:DD:EE:20",
    "ip": "192.168.1.1",
    "intrface": "LAN",
    "type": "ROUTER",
    "admin_pass": "Admin123!",
    "wifi_pass": "WifiPass123!",
    "mac_filter": true
}

###

############################################################
# Update device
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "...",
#   "name": "Desktop Updated",
#   "model": "Updated PC",
#   "mac": "AA:BB:CC:DD:EE:10",
#   "intrface": "LAN",
#   "type": "CLIENT"
# }
############################################################

PUT {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "79c30cba-6c6f-4498-8edc-fda473f91d61",
    "name": "Desktop Updated",
    "model": "Updated PC",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

############################################################
# Delete device
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "..."
# }
############################################################

DELETE {{baseUrl}}/DEVICE_ID
Authorization: Bearer {{token}}

###

############################################################
# Business Error - Device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

PUT {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "00000000-0000-0000-0000-000000000000",
    "name": "Unknown Device"
}

###

############################################################
# Business Error - Delete device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

DELETE {{baseUrl}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

############################################################
# Business Error - MAC already exists
#
# Expected:
# Status: 409
#
# Response:
# {
#   "message": "Ya existe un dispositivo con esa MAC"
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Duplicate MAC",
    "model": "Custom PC",
    "mac": "AA:BB:CC:DD:EE:10",
    "intrface": "LAN",
    "type": "CLIENT"
}

###

