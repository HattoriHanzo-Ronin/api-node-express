# Devices Error Handling Tests
#
# Purpose
# -------
# Manual test suite for validating:
#
# - Device CRUD operations.
# - Schema validation errors.
# - Business rules.
# - Error handler responses.
#
# This file may also be used for general API testing.
#
# Prerequisites
# -------------
# - Execute auth.http first.
# - Valid access token.
# - API running on localhost:59998
#
# Notes
# -----
# - CLIENT devices do not require an IP.
# - SERVER devices require a valid IP.
# - ROUTER devices require a valid IP, admin_pass and mac_filter.
# - ROUTER devices require model when mac_filter is true.
# - Only ROUTER devices can use admin_pass, wifi_pass and mac_filter.
# - Device connections must include at least one MAC and ctype.
# - Connection MAC addresses must be unique.

@baseUrl = http://localhost:59998/devices
@token = PASTE_ACCESS_TOKEN
@deviceId = PASTE_DEVICE_ID
@routerId = PASTE_ROUTER_ID

############################################################
# Get all devices
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Desktop Test",
#       "type": "CLIENT",
#       "connections": [
#           {
#               "mac": "AA:BB:CC:DD:EE:10",
#               "ctype": "LAN"
#           }
#       ]
#   },
#   {
#       "id": "...",
#       "name": "Router Test",
#       "model": "TP-Link Archer AX53",
#       "type": "ROUTER",
#       "ip": "192.168.1.1",
#       "admin_pass": "Admin123!",
#       "wifi_pass": "WifiPass123!",
#       "mac_filter": true,
#       "capabilities": {
#           "addAllow": true,
#           "deleteAllow": true
#       },
#       "connections": [
#           {
#               "mac": "AA:BB:CC:DD:EE:30",
#               "ctype": "LAN"
#           }
#       ]
#   }
# ]
############################################################

GET {{baseUrl}}
Authorization: Bearer {{token}}

###

############################################################
# Get allowed devices by router
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Desktop Test",
#       "type": "CLIENT",
#       "connections": [
#           {
#               "mac": "AA:BB:CC:DD:EE:10",
#               "ctype": "LAN"
#           }
#       ]
#   }
# ]
############################################################

GET {{baseUrl}}/allowed/{{routerId}}
Authorization: Bearer {{token}}

###

############################################################
# Get not allowed devices by router
#
# Expected:
# Status: 200
#
# Response:
# [
#   {
#       "id": "...",
#       "name": "Server Test",
#       "type": "SERVER",
#       "ip": "192.168.1.20",
#       "connections": [
#           {
#               "mac": "AA:BB:CC:DD:EE:20",
#               "ctype": "LAN"
#           }
#       ]
#   }
# ]
############################################################

GET {{baseUrl}}/notallowed/{{routerId}}
Authorization: Bearer {{token}}

###

############################################################
# Create client
#
# Expected:
# Status: 201
#
# Response:
# {
#   "id": "...",
#   "name": "Desktop Test",
#   "type": "CLIENT",
#   "connections": [
#       {
#           "mac": "AA:BB:CC:DD:EE:10",
#           "ctype": "LAN"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop Test",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:10", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}

###

############################################################
# Create server
#
# Expected:
# Status: 201
#
# Response:
# {
#   "id": "...",
#   "name": "Server Test",
#   "type": "SERVER",
#   "ip": "192.168.1.20",
#   "connections": [
#       {
#           "mac": "AA:BB:CC:DD:EE:20",
#           "ctype": "LAN"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Server Test",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:20", "ctype": "LAN" }
    ],
    "type": "SERVER",
    "ip": "192.168.1.20"
}

###

############################################################
# Create router
#
# Expected:
# Status: 201
#
# Response:
# {
#   "id": "...",
#   "name": "Router Test",
#   "model": "TP-Link Archer AX53",
#   "type": "ROUTER",
#   "ip": "192.168.1.1",
#   "admin_pass": "Admin123!",
#   "wifi_pass": "WifiPass123!",
#   "mac_filter": true,
#   "capabilities": {
#       "addAllow": true,
#       "deleteAllow": true
#   },
#   "connections": [
#       {
#           "mac": "AA:BB:CC:DD:EE:30",
#           "ctype": "LAN"
#       },
#       {
#           "mac": "AA:BB:CC:DD:EE:31",
#           "ctype": "WIFI"
#       }
#   ]
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Router Test",
    "model": "TP-Link Archer AX53",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:30", "ctype": "LAN" },
        { "mac": "AA:BB:CC:DD:EE:31", "ctype": "WIFI" }
    ],
    "type": "ROUTER",
    "ip": "192.168.1.1",
    "admin_pass": "Admin123!",
    "wifi_pass": "WifiPass123!",
    "mac_filter": true
}

###

############################################################
# Update device
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "...",
#   "name": "Desktop Updated",
#   "type": "CLIENT",
#   "connections": [
#       {
#           "mac": "AA:BB:CC:DD:EE:11",
#           "ctype": "LAN"
#       }
#   ]
# }
############################################################

PUT {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "{{deviceId}}",
    "name": "Desktop Updated",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:11", "ctype": "LAN" }
    ]
}

###

############################################################
# Delete device
#
# Expected:
# Status: 200
#
# Response:
# {
#   "id": "..."
# }
############################################################

DELETE {{baseUrl}}/{{deviceId}}
Authorization: Bearer {{token}}

###

############################################################
# Business Error - Device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

PUT {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "00000000-0000-0000-0000-000000000000",
    "name": "Unknown Device"
}

###

############################################################
# Business Error - Delete device not found
#
# Expected:
# Status: 404
#
# Response:
# {
#   "message": "El dispositivo no existe"
# }
############################################################

DELETE {{baseUrl}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

############################################################
# Business Error - Device name already exists
#
# Expected:
# Status: 409
#
# Response:
# {
#   "message": "El nombre del dispositivo ya está en uso"
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Desktop Test",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:40", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}

###

############################################################
# Business Error - Connection MAC already exists
#
# Expected:
# Status: 409
#
# Response:
# {
#   "message": "La mac ya está en uso"
# }
############################################################

POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Duplicate MAC",
    "connections": [
        { "mac": "AA:BB:CC:DD:EE:10", "ctype": "LAN" }
    ],
    "type": "CLIENT"
}

###

############################################################
# Validation Error - Missing request body
