# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
PORT=59998
THUMBNAIL_GENERATOR_PORT=3000
API_URL=http://api.example:59998
THUMBNAIL_GENERATOR_URL=http://thumbnail-generator.example:3000
CHROME_PATH=/usr/bin/google-chrome

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------
HOSTDB=localhost
PORTDB=5432
USERDB=postgres
PASSDB_FILE=/secrets/api-node-express/postgres-password
DB=my_database

# ------------------------------------------------------------------
# FTP Server
# ------------------------------------------------------------------
HOSTFTP=ftp.example.com
PORTFTP=22
FTP_MAX_CONNECTIONS=100
FTP_MAX_TRANSFERS=16
FTP_IDLE_TIMEOUT=900000
FTP_SCALE_WAIT=5000
FTP_PROTECTED_USERS=username:6,another-user:6
SFTP_KEY_FILE=/secrets/api-node-express/sftp-key

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
JWT_SECRET_FILE=/secrets/api-node-express/jwt-secret
REFRESH_JWT_SECRET_FILE=/secrets/api-node-express/refresh-jwt-secret
