# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NODE_ENV=production
PORT=59998
THUMBNAIL_GENERATOR_URL=http://thumbnail-generator.example:3000
ROUTER_CPANEL_SERVICE_URL=http://router-cpanel-service.example:3000
CHROME_PATH=/usr/bin/google-chrome

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------
HOSTDB=localhost
PORTDB=5432
USERDB=postgres
PASSDB_FILE=/secrets/api-node-express/postgres-password
DB=my_database

# ------------------------------------------------------------------
# FTP Server
# ------------------------------------------------------------------
HOSTFTP=ftp.example.com
PORTFTP=22
FTP_MAX_CONNECTIONS=100
FTP_MAX_TRANSFERS=16
FTP_IDLE_TIMEOUT=900000
FTP_SCALE_WAIT=5000
FTP_PROTECTED_USER_IDS=user-id:6,another-user-id:6
FTP_INTERNAL_POOL_MIN=1
FTP_INTERNAL_POOL_MAX=1
FTP_READ_POOL_MIN=1
FTP_READ_POOL_MAX=2
FTP_WRITE_POOL_MIN=1
FTP_WRITE_POOL_MAX=3
FTP_MEDIA_SESSION_TIMEOUT=60000
FTP_TRANSFER_SESSION_TIMEOUT=900000
FTP_MAX_UPLOAD_CHUNK_SIZE=0
FTP_MAX_THUMBNAIL_SIZE=5242880
FTP_DIRECTORY_CHECK_TIMEOUT=5000
SFTP_KEY_FILE=/secrets/api-node-express/sftp-key

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------
MEMORY_CACHE_MAX_SIZE=2147483648
MEMORY_CACHE_MAX_SIZE_PER_OWNER=419430400
MEMORY_CACHE_INACTIVITY_TIMEOUT=600000
DIRECTORY_CACHE_INACTIVITY_TIMEOUT=600000

# ------------------------------------------------------------------
# Socket sessions
# ------------------------------------------------------------------
SOCKET_MAX_CONNECTIONS=300
SOCKET_MAX_CONNECTIONS_PER_USER=3
SOCKET_SESSION_INACTIVITY_TIMEOUT=900000

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
JWT_SECRET_FILE=/secrets/api-node-express/jwt-secret
REFRESH_JWT_SECRET_FILE=/secrets/api-node-express/refresh-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=30min
JWT_REFRESH_TOKEN_EXPIRES_IN=60d
